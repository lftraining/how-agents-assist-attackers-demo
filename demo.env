# demo.env — every name, namespace, label, port, and path the demo uses, defined once.
#
# Both bash and make read this file:
#   - Write KEY=value only: no quotes, no spaces around '=', no $VAR references.
#   - Put comments on their own line.
#   - An environment variable overrides a value for scripts; for make, use `make KEY=value`.

# --- Cluster ---------------------------------------------------------------------
CLUSTER_NAME=demo
KUBE_CONTEXT=kind-demo
KIND_CONFIG=cluster/kind-config.yaml
KIND_NODE_CONTAINER=demo-control-plane
KIND_DOCKER_NETWORK=kind
# The longest each readiness check waits. Checks return as soon as they pass.
TIMEOUT=180s
# Readiness check groups. Set one to 0 to skip it while debugging.
CHECK_FALCO=1
CHECK_AGENT=1
# The goose fence proof takes about 30 seconds, so the quick gate before each demo step skips it.
CHECK_SANDBOX=1

# --- Namespaces ------------------------------------------------------------------
CILIUM_NS=kube-system
COREDNS_NS=kube-system
FALCO_NS=falco
# agentgateway and the three MCP servers.
DEMO_NS=demo-agent
# goose alone, behind its fence. The model-key Secret exists only here.
AGENT_NS=agent

# --- Falco -----------------------------------------------------------------------
FALCO_DS=falco
FALCO_SELECTOR=app.kubernetes.io/name=falco
# falcosidekick forwards Falco alerts; its log shows every alert it receives.
FALCO_SIDEKICK_DEPLOY=falco-falcosidekick
# Unique alert markers, so tests match the demo's rules and not Falco's built-in ones.
FALCO_CRED_MARKER=AGENT_CRED_READ
FALCO_EXFIL_MARKER=AGENT_EXFIL_ATTEMPT

# --- agentgateway -----------------------------------------------------------------
GATEWAY_DEPLOY=agentgateway
GATEWAY_CONFIGMAP=agentgateway-config
GATEWAY_POLICY=controls/agentgateway/mcp-authz-policy.yaml
GATEWAY_IMAGE=ghcr.io/agentgateway/agentgateway:v1.6.0
GATEWAY_IMAGE_DIGEST=sha256:9d3e6044ddcdc0878b1787f77bd401252b95e22684203fb5e874c4c42d2ed90c
# Keep the Service port and the container port equal.
GATEWAY_SERVICE=agentgateway
GATEWAY_SERVICE_PORT=3000
GATEWAY_CONTAINER_PORT=3000
GATEWAY_MCP_PATH=/mcp
GATEWAY_POD_LABEL=app=agentgateway
# The exfiltration tool that the defended gateway removes and refuses.
EXFIL_TOOL_NAME=http_post

# --- MCP servers (one Deployment each) --------------------------------------------
MCP_FS_DEPLOY=mcp-fs
MCP_FETCH_DEPLOY=mcp-fetch
MCP_HTTP_POST_DEPLOY=mcp-http-post
MCP_DEPLOYS=mcp-fs mcp-fetch mcp-http-post
MCP_MANIFESTS=agent/mcp-servers/k8s
MCP_FS_IMAGE=mcp-fs:1.0.0
MCP_FETCH_IMAGE=mcp-fetch:1.0.0
MCP_HTTP_POST_IMAGE=mcp-http-post:1.0.0
# Policies and tests select MCP pods by this role label.
ROLE_LABEL_KEY=demo-role
ROLE_FS=fs
ROLE_FETCH=fetch
ROLE_HTTP_POST=http-post
# The decoy's path inside mcp-fs. Falco's rule and the smoke test use the same path.
FS_WORKSPACE=/workspace
DECOY_CRED_PATH=/workspace/.aws/credentials
# The project the agent builds. Each run clears it first, so run two never sees run one's output.
DELIVERABLE_DIR=/workspace/corewave-service

# --- goose agent ------------------------------------------------------------------
RECIPE=agent/recipe.yaml
GOOSE_IMAGE=goose-sandbox:1.0.0
GOOSE_UID=10001
# The goose fence selects this label.
GOOSE_LABEL=app=goose-agent
GOOSE_JOB_NAME=goose-run
GOOSE_JOB_MANIFEST=agent/goose-job.yaml
GATEWAY_URL=http://agentgateway.demo-agent.svc.cluster.local:3000/mcp
GOOSE_BASELINE_POLICY=controls/cilium/goose-baseline-egress.yaml

# --- Model vendor and API key ----------------------------------------------------
# Choose openrouter, anthropic, or openai. `make set-model-key` asks you and saves your
# choice in the gitignored demo.local.env, which overrides this line.
MODEL_VENDOR=openrouter
# scripts/lib/common.sh copies the chosen vendor's block below into MODEL_PROVIDER,
# MODEL_KEY_VAR, MODEL_API_FQDN, MODEL_BASE_URL, and MODEL_ID. The goose fence allows only
# that vendor's API host. If a model is retired, set a current one with `make set-model-key`.
MODEL_KEY_SECRET=model-api-key

# OpenRouter: recommended and tested.
OPENROUTER_PROVIDER=openrouter
OPENROUTER_KEY_VAR=OPENROUTER_API_KEY
OPENROUTER_API_FQDN=openrouter.ai
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Anthropic (Claude): supported, not tested.
ANTHROPIC_PROVIDER=anthropic
ANTHROPIC_KEY_VAR=ANTHROPIC_API_KEY
ANTHROPIC_API_FQDN=api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OpenAI (ChatGPT): supported, not tested.
OPENAI_PROVIDER=openai
OPENAI_KEY_VAR=OPENAI_API_KEY
OPENAI_API_FQDN=api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Attacker side (local Docker containers on the kind network) -------------------
VENDOR_DOCS_CONTAINER=vendor-docs
COLLECTOR_CONTAINER=collector
ATTACKER_VENDOR_DOCS_IMAGE=aaa-attacker/vendor-docs:1.0.0
ATTACKER_COLLECTOR_IMAGE=aaa-attacker/collector:1.0.0
DOCS_HOST=docs.corewave.test
DOCS_PORT=80
COLLECTOR_HOST=telemetry.corewave.test
COLLECTOR_PORT=80
# Each attacker IP is a position counted down from the top of the kind network's range.
# To use fixed addresses instead, export VENDOR_DOCS_IP and COLLECTOR_IP.
VENDOR_DOCS_IP_FROM_TOP=10
COLLECTOR_IP_FROM_TOP=20
# scripts/render-config.sh fills the computed values into the config templates and writes
# the copies that are applied here.
RENDERED_DIR=.runtime/rendered
CHECK_DOCKER_CONTAINERS=1
DOCKER_CONTAINERS=collector vendor-docs
# A throwaway value that the Falco smoke test writes. The agent never sees it.
FAKE_CRED_MARKER=EXAMPLE
# Hosts that the inertness checks accept as local.
ALLOWED_HOST_PATTERN=(localhost|127\.0\.0\.1|0\.0\.0\.0|::1|[A-Za-z0-9.-]+\.test|[A-Za-z0-9.-]+\.svc\.cluster\.local|172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]+\.[0-9]+)

# --- Local skill registry and signing --------------------------------------------
REGISTRY_NAME=kind-registry
REGISTRY_PORT=5001
REGISTRY=localhost:5001
REGISTRY_IMAGE=registry:3.1.2@sha256:ddf754342cfc8acc51a56d5d0ab6af06826461864460636d8bd5c546dab2a7b8
REGISTRY_CONTAINER_PORT=5000
# The registry's storage. `make down CONFIRM=1` deletes it.
REGISTRY_VOLUME=aaa-registry-store
# The registry's own network, with no internet access. Only 127.0.0.1:REGISTRY_PORT reaches it.
REGISTRY_NETWORK=aaa-registry
# The registry's CA certificate.
REGISTRY_RUNTIME_DIR=.runtime/registry
REGISTRY_CA_BUNDLE=.runtime/registry/ca-bundle.pem
SKILL_REPO=skills/corewave-sdk-conventions
SKILL_TAG=1.0.0
# The tamper test pushes here, never to the live repository.
SKILL_TAMPER_REPO=tamper-test/corewave-sdk-conventions
SKILL_DIR=skill-bundle/good-skill
SKILL_FILE=SKILL.md
SKILL_NAME=corewave-sdk-conventions
# The tampered skill, with one line changed, that ToolHive must refuse.
SKILL_TAMPERED_FILE=attacker/tampered-skill/SKILL.md
# Where ToolHive installs the verified skill. run-task.sh mounts that copy into the goose pod.
GOOSE_PROJECT_DIR=.runtime/goose-project
ARTIFACT_TYPE=dev.toolhive.skills.v1
# The signed digest.
SKILL_DIGEST_FILE=skill-bundle/bundle.digest
# none (default): sign offline with the throwaway key, with no public record.
# rekor (optional): also record the signature in the public Rekor log, permanently.
TLOG_MODE=none
REKOR_URL=https://rekor.sigstore.dev
REKOR_SEARCH_URL=https://search.sigstore.dev
# In rekor mode, this folder keeps a signature backup and the Rekor public key.
SIGSTORE_RUNTIME_DIR=.runtime/sigstore
# ToolHive's API server for the demo, on its own port and state folder.
THV_API_PORT=18080
THV_STATE_DIR=.runtime/toolhive
# cosign must stay on 2.6.x.
COSIGN_REQUIRED_LINE=2.6

# --- Throwaway test-pod images (pulled into the node by digest) -----------------------
NETTEST_IMAGE=nicolaka/netshoot:v0.16@sha256:b09d9b21381f47a79b3cbcb30da25266dc17186ea00ae65e99fdc51396f48e70
SHELLTEST_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
